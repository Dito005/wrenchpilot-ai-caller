# ─── ElevenLabs ConvAI + Telnyx SIP (demo_followup) ───────────────────────────
# See docs/EL_TELNYX_STACK.md. Agent/phone IDs are pinned in code, not env.
ELEVENLABS_API_KEY=
# Route dialer + scheduler through EL demo_followup instead of Twilio + Gemini.
EL_DEMO_FOLLOWUP_ENABLED=false
# Separate gate for real outbound calls. Leave false until Adeel says go —
# while false, every EL dial is refused (dry runs still work).
EL_PLACE_CALLS_APPROVED=false

# ─── Legacy Twilio + Gemini Live path (used when EL_DEMO_FOLLOWUP_ENABLED!=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
GOOGLE_AI_API_KEY=

# ─── Shared ──────────────────────────────────────────────────────────────────
CALENDLY_API_TOKEN=
CALENDLY_USER_URI=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
DATABASE_URL=
JWT_SECRET=
